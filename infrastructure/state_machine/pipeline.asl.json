{
  "Comment": "VitalStream FHIR-to-OMOP pipeline: validate, transform, quality check, catalog",
  "StartAt": "TransformFHIRtoOMOP",
  "States": {
    "TransformFHIRtoOMOP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${etl_job_name}",
        "Arguments": {
          "--source_path.$": "States.Format('s3://{}/{}', $.source_bucket, $.source_key)",
          "--target_path": "${target_path}",
          "--pcornet_target_path": "${pcornet_target_path}",
          "--ingest_id.$": "States.Hash($.source_key, 'SHA-256')"
        }
      },
      "ResultPath": "$.etl_result",
      "Next": "DataQualityCheck",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "DataQualityCheck": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${dq_job_name}",
        "Arguments": {
          "--target_path": "${target_path}",
          "--pcornet_target_path": "${pcornet_target_path}",
          "--dq_output_path": "${dq_output_path}",
          "--ingest_id.$": "States.Hash($.source_key, 'SHA-256')"
        }
      },
      "ResultPath": "$.dq_result",
      "Next": "UpdateCatalog",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "UpdateCatalog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "${crawler_name}"
      },
      "ResultPath": "$.crawler_result",
      "Next": "WaitForCrawler",
      "Retry": [
        {
          "ErrorEquals": ["Glue.CrawlerRunningException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "WaitForCrawler": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "GetCrawlerStatus"
    },
    "GetCrawlerStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "${crawler_name}"
      },
      "ResultSelector": {
        "state.$": "$.Crawler.State",
        "last_crawl_status.$": "$.Crawler.LastCrawl.Status"
      },
      "ResultPath": "$.crawler_status",
      "Next": "CrawlerFinished",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CrawlerFinished": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_status.state",
          "StringEquals": "READY",
          "Next": "CrawlerSucceeded"
        }
      ],
      "Default": "WaitForCrawler"
    },
    "CrawlerSucceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_status.last_crawl_status",
          "StringEquals": "SUCCEEDED",
          "Next": "PipelineSucceeded"
        }
      ],
      "Default": "CatalogUpdateFailed"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "CatalogUpdateFailed": {
      "Type": "Fail",
      "Error": "CatalogUpdateFailed",
      "Cause": "The Glue crawler finished without SUCCEEDED. Check the crawler's CloudWatch logs."
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineExecutionFailed",
      "Cause": "One or more pipeline steps failed. Check CloudWatch logs for details."
    }
  }
}
